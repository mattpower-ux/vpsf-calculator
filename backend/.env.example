DATABASE_URL=sqlite:///./vpsf.db
FRONTEND_ORIGIN=http://localhost:5173

# Address lookup / geocoding
MAPBOX_ACCESS_TOKEN=

# Property records (ATTOM is retired)
RENTCAST_API_KEY=
RENTCAST_MONTHLY_LIMIT=100

# Permit evidence; server-side only. Requests share the account's provider quota.
PERMIT_STACK_API_KEY=
PERMIT_STACK_MONTHLY_LIMIT=100

# Usage cap notifications
ALERT_EMAIL_TO=matt.power@greenbuildermedia.com
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Structured extraction and scoring explanations
OPENAI_API_KEY=

# OCR provider: mistral or google_document_ai
OCR_PROVIDER=mistral

# Mistral OCR
MISTRAL_API_KEY=

# Google Document AI OCR, only needed if OCR_PROVIDER=google_document_ai
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Optional address exterior imagery (server-side key; enable Street View Static API).
# Restrict the key to this API and server IPs where feasible; set a Google project quota.
GOOGLE_STREET_VIEW_API_KEY=

# Optional Crawl4AI Cloud search for exact-address public facts and listing-photo fallback.
CRAWL4AI_API_KEY=
